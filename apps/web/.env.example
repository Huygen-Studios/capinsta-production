NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense is disabled unless enabled=true and all required real values
# are supplied. Never commit publisher or slot IDs.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_AUTO_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_TOP_SLOT=
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=
NEXT_PUBLIC_SUPABASE_URL=<YOUR_SUPABASE_PROJECT_URL>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_PUBLIC_KEY>
NEXT_PUBLIC_MARBLE_API_URL=http://127.0.0.1:3001

NEXT_PUBLIC_ENABLE_AI_CAPTIONS=true
NEXT_PUBLIC_ENABLE_CAPINSTA_SAMPLE_IMPORT=false
NEXT_PUBLIC_CAPINSTA_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CAPINSTA_DEBUG=false

DATABASE_URL=postgresql://user:password@localhost:5432/capinsta
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
UPSTASH_REDIS_REST_URL=https://example-upstash-url
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token
MARBLE_WORKSPACE_KEY=replace-with-marble-workspace-key
