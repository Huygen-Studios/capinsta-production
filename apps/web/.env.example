NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense still requires valid provider identifiers. The database
# advertisements_enabled flag is an additional runtime kill switch.
NEXT_PUBLIC_ADSENSE_ENABLED=true
NEXT_PUBLIC_ADSENSE_AUTO_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-1790543418739606
NEXT_PUBLIC_ADSENSE_TOP_SLOT=
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=
NEXT_PUBLIC_AD_LAYOUT_PREVIEW=false
NEXT_PUBLIC_REACT_SCAN_ENABLED=false

# Local Playwright/manual UI verification only. Ignored in production.
CAPINSTA_UI_TEST_AUTH=false
UI_VERIFICATION=false
NEXT_PUBLIC_SUPABASE_URL=<YOUR_SUPABASE_PROJECT_URL>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_PUBLIC_KEY>
NEXT_PUBLIC_MARBLE_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=true

NEXT_PUBLIC_ENABLE_AI_CAPTIONS=true
NEXT_PUBLIC_CAPINSTA_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CAPINSTA_DEBUG=false
NEXT_PUBLIC_CAPINSTA_JOB_TIMEOUT_MS=600000
NEXT_PUBLIC_CAPINSTA_JOB_POLL_INTERVAL_MS=2000

DATABASE_URL=postgresql://user:password@localhost:5432/capinsta
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
UPSTASH_REDIS_REST_URL=https://example-upstash-url
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token
MARBLE_WORKSPACE_KEY=replace-with-marble-workspace-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
ADMIN_SECURITY_PEPPER=replace-with-at-least-32-random-bytes
INTERNAL_ADMIN_API_SECRET=replace-with-at-least-32-random-bytes
ADMIN_ASSERTION_ISSUER=capinsta-web
INTERNAL_MAINTENANCE_SECRET=replace-with-at-least-32-random-bytes
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
CAPINSTA_RENDER_TOKEN_SECRET=replace-with-the-same-render-secret-as-backend
TRUSTED_PROXY_MODE=none
COMMIT_SHA=development

# Temporary. Remove immediately after running bun run admin:bootstrap.
CAPINSTA_ADMIN_BOOTSTRAP_USER_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://g.huygenstudios.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_API_HOST=https://us.posthog.com

# Razorpay donations. Server-only secrets must never use NEXT_PUBLIC_.
PAYMENTS_ENABLED=false
PAYMENT_ENVIRONMENT=test
APP_URL=http://localhost:3000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_PREVIOUS_SECRET=
PAYMENT_SUPPORT_EMAIL=
DONATION_RECEIPTS_ENABLED=true

# Dedicated worker provisioning. Keep manual until real infrastructure is wired.
DEDICATED_WORKER_PROVISIONING_ADAPTER=manual
DEDICATED_WORKER_PROVISIONING_ENDPOINT=
DEDICATED_WORKER_PROVISIONING_TOKEN=
