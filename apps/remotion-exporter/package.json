{
	"name": "@capinsta/remotion-exporter",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"bundle": "bun build src/bundle.ts --target=node --packages=external --outfile=.cache/bundle-run.mjs && node .cache/bundle-run.mjs",
		"fixture": "bun src/fixture.ts",
		"render": "bun build src/render.ts --target=node --packages=external --outfile=.cache/render-run.mjs && node .cache/render-run.mjs",
		"hybrid": "bun build src/hybrid-export.ts --target=node --packages=external --outfile=.cache/hybrid-run.mjs && node .cache/hybrid-run.mjs",
		"smoke": "bun build src/smoke.ts --target=node --packages=external --outfile=.cache/smoke-run.mjs && node .cache/smoke-run.mjs",
		"benchmark": "bun build src/benchmark.ts --target=node --packages=external --outfile=.cache/benchmark-run.mjs && node .cache/benchmark-run.mjs",
		"benchmark:phase2": "bun build src/phase2-benchmark.ts --target=node --packages=external --outfile=.cache/phase2-benchmark-run.mjs && node .cache/phase2-benchmark-run.mjs",
		"benchmark:hybrid": "bun build src/hybrid-benchmark.ts --target=node --packages=external --outfile=.cache/hybrid-benchmark-run.mjs && node .cache/hybrid-benchmark-run.mjs",
		"audit:alpha": "bun build src/alpha-audit.ts --target=node --packages=external --outfile=.cache/alpha-audit-run.mjs && node .cache/alpha-audit-run.mjs",
		"acceptance:hybrid": "bun build src/hybrid-acceptance.ts --target=node --packages=external --outfile=.cache/hybrid-acceptance-run.mjs && node .cache/hybrid-acceptance-run.mjs",
		"audit:solid-colors": "bun build src/solid-color-audit.ts --target=node --packages=external --outfile=.cache/solid-color-audit-run.mjs && node .cache/solid-color-audit-run.mjs",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@capinsta/transcript-contract": "workspace:*",
		"@remotion/renderer": "4.0.507",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"remotion": "4.0.507",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@remotion/bundler": "4.0.507",
		"@remotion/cli": "4.0.507",
		"@remotion/media": "4.0.507",
		"@types/bun": "1.3.5",
		"@types/node": "24.2.1",
		"@types/react": "19.2.10",
		"@types/react-dom": "19.2.3",
		"typescript": "6.0.2"
	}
}
