NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://capinsta.example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
NEXT_PUBLIC_MARBLE_API_URL=https://api.marblecms.com
NEXT_PUBLIC_ENABLE_AI_CAPTIONS=true

DATABASE_URL=postgresql://capinsta_app:replace-password@postgres.internal:5432/capinsta
WEB_DATABASE_MAX_CONNECTIONS=5

UPSTASH_REDIS_REST_URL=https://replace-with-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=replace-with-redis-rest-token

SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
ADMIN_SECURITY_PEPPER=replace-with-at-least-32-random-characters
INTERNAL_ADMIN_API_SECRET=replace-with-at-least-32-random-characters
INTERNAL_MAINTENANCE_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_KEY_SECRET=replace-with-at-least-32-random-characters
PAGINATION_CURSOR_SECRET=replace-with-at-least-32-random-characters
ADMIN_ASSERTION_ISSUER=capinsta-web
BACKEND_INTERNAL_URL=http://backend:10000
TRUSTED_PROXY_MODE=cloudflare

FRONTEND_URL=https://capinsta.example.com
CORS_ORIGINS=https://capinsta.example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=
ADMIN_DATABASE_URL=postgresql://capinsta_admin:replace-password@postgres.internal:5432/capinsta

STT_PROVIDER=auto
STT_PROVIDER_ORDER=gemini,sarvam,groq_whisper,openai_whisper
STT_PROVIDER_ATTEMPT_TIMEOUT_SECONDS=60
GEMINI_API_KEY=
SARVAM_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

TEMP_DIR=/app/storage/tmp
MEDIA_DIR=/app/storage/media
UPLOAD_DIR=/app/storage/uploads
EXPORT_DIR=/app/storage/exports
CACHE_DIR=/app/storage/cache
DB_PATH=/app/storage/database.sqlite
MAX_UPLOAD_SIZE_MB=500
CAPTION_DURATION_LIMIT_SECONDS=180
MAX_JSON_BODY_BYTES=1048576
MAX_FORM_BODY_BYTES=8388608
MAX_MEDIA_DURATION_SECONDS=600
MAX_MEDIA_LONG_EDGE=4096
MAX_CONCURRENT_EXPORTS=1
MAX_EXPORT_DURATION_SECONDS=300

CAPTION_JOB_MAX_SECONDS=600
CAPTION_JOB_STALE_SECONDS=120
CAPTION_JOB_HEARTBEAT_INTERVAL_SECONDS=15
PROJECT_INACTIVITY_TTL_MINUTES=15
PROJECT_CLEANUP_INTERVAL_SECONDS=60
PROJECT_MAX_LIFETIME_MINUTES=90

DISK_WARNING_FREE_BYTES=10737418240
DISK_REJECT_UPLOAD_FREE_BYTES=8589934592
DISK_CRITICAL_FREE_BYTES=5368709120

FFMPEG_PATH=
CAPINSTA_RENDER_BASE_URL=https://capinsta.example.com
RENDER_PAGE_URL=https://capinsta.example.com/render
CAPINSTA_RENDER_TOKEN_SECRET=replace-with-at-least-32-random-characters
CAPINSTA_RENDER_PAGE_TIMEOUT_MS=30000
EXPORT_MAX_LONG_EDGE=1920
EXPORT_MAX_FPS=60
EXPORT_FFMPEG_THREADS=1
