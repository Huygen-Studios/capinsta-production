HOST=127.0.0.1
PORT=8000
NODE_ENV=development
LOG_LEVEL=INFO

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

STT_PROVIDER=auto
GROQ_API_KEY=replace-with-groq-api-key
OPENAI_API_KEY=replace-with-openai-api-key
SARVAM_API_KEY=replace-with-sarvam-api-key
LLM_API_KEY=replace-with-llm-api-key

TEMP_DIR=storage
UPLOAD_DIR=storage/uploads
EXPORT_DIR=storage/exports
CACHE_DIR=storage/cache
DB_PATH=storage/caption_ai.db
MAX_UPLOAD_SIZE_MB=500
MAX_CONCURRENT_EXPORTS=1
MAX_EXPORT_DURATION_SECONDS=300

FFMPEG_PATH=
RENDER_PAGE_URL=
EXPORT_PREFER_BUNDLED_RENDER=true
EXPORT_RENDER_SAFE_MODE=true
EXPORT_MAX_LONG_EDGE=1280
EXPORT_MAX_FPS=24
EXPORT_FFMPEG_THREADS=1

PAUSE_SPLIT_THRESHOLD=0.45
DEFAULT_GLOBAL_CAPTION_OFFSET=0
ALIGNMENT_PROVIDER=auto
ENABLE_WHISPERX=false
ENABLE_STABLE_TS=false
ENABLE_SILERO_VAD=false
STABLE_TS_MODEL=base
STABLE_TS_DEVICE=auto
SILERO_VAD_DEVICE=auto
