HOST=127.0.0.1
PORT=8000
NODE_ENV=development
LOG_LEVEL=INFO

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

SUPABASE_URL=<YOUR_SUPABASE_PROJECT_URL>
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_PUBLIC_KEY>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>
# Required only when Auth access tokens are signed with legacy HS256.
# ES256/RS256 projects use SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=
INTERNAL_ADMIN_API_SECRET=replace-with-at-least-32-random-bytes
ADMIN_ASSERTION_ISSUER=capinsta-web
INTERNAL_MAINTENANCE_SECRET=replace-with-at-least-32-random-bytes
RATE_LIMIT_KEY_SECRET=replace-with-at-least-32-random-bytes
PAGINATION_CURSOR_SECRET=replace-with-at-least-32-random-bytes
ADMIN_DATABASE_URL=postgresql://user:password@postgres:5432/capinsta
ENABLE_SUPABASE_DURABLE_JOBS=false
ENABLE_SUPABASE_MEDIA_STORAGE=false
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_SOURCE_MEDIA_BUCKET=source-media
SUPABASE_MEDIA_VARIANTS_BUCKET=media-variants
SUPABASE_MEDIA_EXPORTS_BUCKET=media-exports
MEDIA_UPLOAD_PROTOCOL=tus
MEDIA_UPLOAD_MAX_BYTES=2147483648
MAX_SOURCE_FILE_BYTES=2147483648
MAX_ACTIVE_UPLOADS_PER_USER=2
MEDIA_PREVIEW_URL_TTL_SECONDS=900
MEDIA_DOWNLOAD_URL_TTL_SECONDS=300
MEDIA_SIGNED_URL_MAX_TTL_SECONDS=3600
MEDIA_UPLOAD_SESSION_TTL_SECONDS=7200
ENABLE_DURABLE_PROCESSING_WORKER=false
PROCESSING_WORKER_ID=
PROCESSING_WORKER_POLL_SECONDS=2
PROCESSING_WORKER_MAX_CONCURRENCY=1
PROCESSING_WORKER_SHUTDOWN_GRACE_SECONDS=30
PROCESSING_JOB_LEASE_SECONDS=90
PROCESSING_JOB_HEARTBEAT_SECONDS=30
PROCESSING_JOB_RETRY_BASE_SECONDS=10
PROCESSING_JOB_RETRY_MULTIPLIER=2
PROCESSING_JOB_RETRY_MAX_SECONDS=900
PROCESSING_JOB_RETRY_JITTER_PERCENT=20
PROCESSING_JOB_RECOVERY_INTERVAL_SECONDS=30
PROCESSING_JOB_RECOVERY_BATCH_SIZE=100
ENABLE_MEDIA_PROBE_HANDLER=false
FFPROBE_BINARY=ffprobe
MEDIA_PROBE_TIMEOUT_SECONDS=45
MEDIA_PROBE_TERMINATE_GRACE_SECONDS=3
MEDIA_PROBE_SIGNED_URL_TTL_SECONDS=120
MEDIA_PROBE_SIGNED_URL_SAFETY_SECONDS=10
MEDIA_PROBE_MAX_STDOUT_BYTES=1048576
MEDIA_PROBE_MAX_STDERR_BYTES=65536
MEDIA_PROBE_PROBE_SIZE_BYTES=5000000
MEDIA_PROBE_ANALYZE_DURATION_MICROSECONDS=5000000
MEDIA_PROBE_MAX_DURATION_MS=86400000
MEDIA_PROBE_MAX_FPS=240
MEDIA_PROBE_STORAGE_BACKEND=supabase
# MEDIA_PROBE_LOCAL_STORAGE_ROOT=C:/absolute/development/media-root
ENABLE_MEDIA_VARIANT_PLANNING=false
ENABLE_MEDIA_VARIANT_HANDLERS=false
MEDIA_VARIANT_JOB_TYPES=proxy_generation,audio_extraction,thumbnail_generation,waveform_generation
FFMPEG_BINARY=ffmpeg
MEDIA_VARIANT_TEMP_ROOT=/tmp/capinsta-media-variants
MEDIA_VARIANT_MAX_TEMP_BYTES=2147483648
MEDIA_VARIANT_MAX_STDERR_BYTES=65536
MEDIA_VARIANT_MAX_PROGRESS_BYTES=262144
MEDIA_VARIANT_TERMINATE_GRACE_SECONDS=3
MEDIA_VARIANT_SIGNED_URL_TTL_SECONDS=3600
MEDIA_VARIANT_SIGNED_URL_SAFETY_SECONDS=30
PROXY_TIMEOUT_SECONDS=1800
PROXY_MAX_OUTPUT_BYTES=1073741824
AUDIO_EXTRACTION_TIMEOUT_SECONDS=1800
AUDIO_EXTRACTION_MAX_OUTPUT_BYTES=1073741824
THUMBNAIL_TIMEOUT_SECONDS=120
THUMBNAIL_MAX_OUTPUT_BYTES=20971520
WAVEFORM_TIMEOUT_SECONDS=1800
WAVEFORM_MAX_OUTPUT_BYTES=20971520
WAVEFORM_BUCKET_DURATION_MS=10
WAVEFORM_MAX_PEAKS=200000
MEDIA_VARIANT_DURATION_TOLERANCE_MS=1000
MEDIA_VARIANT_STORAGE_BACKEND=supabase
# MEDIA_VARIANT_LOCAL_STORAGE_ROOT=C:/absolute/development/media-root
ENABLE_DURABLE_TRANSCRIPTION_HANDLER=false
TRANSCRIPTION_STORAGE_BACKEND=supabase
TRANSCRIPTION_TEMP_ROOT=/tmp/capinsta-transcription
TRANSCRIPTION_HANDLER_TIMEOUT_SECONDS=3600
TRANSCRIPTION_PROVIDER_TIMEOUT_SECONDS=120
TRANSCRIPTION_SOURCE_URL_TTL_SECONDS=300
TRANSCRIPTION_SOURCE_DOWNLOAD_TIMEOUT_SECONDS=120
TRANSCRIPTION_MAX_SOURCE_BYTES=2000000000
TRANSCRIPTION_MAX_PROVIDER_RESPONSE_BYTES=64000000
TRANSCRIPTION_MAX_HOTWORDS=50
TRANSCRIPTION_MAX_HOTWORD_LENGTH=100
UPSTASH_REDIS_REST_URL=https://example-upstash-url
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token

STT_PROVIDER=sarvam
DEFAULT_STT_PROVIDER=sarvam
ALLOW_STT_PROVIDER_FALLBACK=false
STT_PROVIDER_ORDER=gemini,sarvam,groq_whisper,openai_whisper
STT_PROVIDER_ATTEMPT_TIMEOUT_SECONDS=60
CAPTION_JOB_MAX_SECONDS=600
CAPTION_JOB_STALE_SECONDS=120
CAPTION_JOB_HEARTBEAT_INTERVAL_SECONDS=15
CAPTION_QUEUE_MODE=local
CAPTION_QUEUE_MAX_USER_RUNNING=2
CAPTION_QUEUE_MAX_GLOBAL_RUNNING=8
CAPTION_QUEUE_MAX_DEPTH=100
CAPTION_QUEUE_LEASE_TIMEOUT_SECONDS=300
CAPTION_QUEUE_MAX_RETRIES=2
CAPTION_QUEUE_RETRY_JITTER_SECONDS=15
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash
OPENAI_TRANSCRIPTION_MODEL=whisper-1
SARVAM_MAX_CONCURRENCY=2
VAD_CHUNKING_ENABLED=true
VAD_TARGET_CHUNK_SECONDS=15
VAD_MAX_CHUNK_SECONDS=25
VAD_CHUNK_PADDING_SECONDS=0.08
GEMINI_API_KEY=
SARVAM_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=replace-with-llm-api-key

LEGACY_CAPTION_STORAGE_ROOT=/app/storage/legacy-caption
TEMP_DIR=/app/storage/legacy-caption/tmp
MEDIA_DIR=/app/storage/legacy-caption/media
UPLOAD_DIR=/app/storage/legacy-caption/uploads
EXPORT_DIR=/app/storage/legacy-caption/exports
CACHE_DIR=/app/storage/legacy-caption/cache
DB_PATH=/app/storage/legacy-caption/database.sqlite
MAX_UPLOAD_SIZE_MB=500
CAPTION_DURATION_LIMIT_SECONDS=180
MAX_JSON_BODY_BYTES=1048576
MAX_FORM_BODY_BYTES=8388608
MAX_CONCURRENT_EXPORTS=1
MAX_EXPORT_DURATION_SECONDS=300
ABANDONED_UPLOAD_RETENTION_HOURS=24
FAILED_EXPORT_RETENTION_HOURS=6
DOWNLOAD_ARTIFACT_RETENTION_HOURS=24
TEMP_AUDIO_RETENTION_HOURS=6
ORPHAN_SCAN_INTERVAL_SECONDS=86400
DISK_WARNING_FREE_BYTES=1073741824
DISK_REJECT_UPLOAD_FREE_BYTES=268435456
DISK_CRITICAL_FREE_BYTES=134217728
PROJECT_INACTIVITY_TTL_MINUTES=15
PROJECT_CLEANUP_INTERVAL_SECONDS=60
PROJECT_MAX_LIFETIME_MINUTES=90

FFMPEG_PATH=
FFPROBE_PATH=
# Prefer an explicit HTTPS frontend render route in production.
RENDER_PAGE_URL=https://capinsta.example.com/render
CAPINSTA_RENDER_BASE_URL=https://capinsta.example.com
CAPINSTA_RENDER_TOKEN_SECRET=replace-with-at-least-32-random-bytes
CAPINSTA_RENDER_PAGE_TIMEOUT_MS=30000
EXPORT_PREFER_BUNDLED_RENDER=true
EXPORT_RENDER_SAFE_MODE=true
EXPORT_MAX_LONG_EDGE=1920
EXPORT_MAX_FPS=60
EXPORT_FFMPEG_THREADS=1
EXPORT_FRAME_CAPTURE_RETRIES=2
EXPORT_RENDER_PAGE_RECYCLE_FRAMES=0
EXPORT_SPARSE_RENDER_ENABLED=true
EXPORT_SPARSE_RENDER_THEMES=*
EXPORT_SPARSE_MIN_FRAME_REDUCTION_PERCENT=30

PAUSE_SPLIT_THRESHOLD=0.30
DEFAULT_GLOBAL_CAPTION_OFFSET=0
ALIGNMENT_PROVIDER=auto
ENABLE_WHISPERX=false
ENABLE_STABLE_TS=false
REFINE_NATIVE_WORD_TIMING_WITH_STABLE_TS=false
STABLE_TS_SEMAPHORE_TIMEOUT_SECONDS=10
ENABLE_SILERO_VAD=true
STABLE_TS_MODEL=base
STABLE_TS_DEVICE=auto
STABLE_TS_MAX_CONCURRENCY=1
CAPINSTA_MODEL_CACHE_DIR=/data/capinsta/model-cache
XDG_CACHE_HOME=/data/capinsta/model-cache/xdg
HF_HOME=/data/capinsta/model-cache/huggingface
TORCH_HOME=/data/capinsta/model-cache/torch
WHISPER_CACHE_DIR=/data/capinsta/model-cache/whisper
STABLE_TS_CACHE_DIR=/data/capinsta/model-cache/stable-ts
SILERO_VAD_DEVICE=auto
# Stage 2.7 durable analysis (opt-in)
ENABLE_TRANSCRIPT_ANALYSIS_HANDLERS=false
ENABLE_TRANSCRIPT_ANALYSIS_PLANNING=false
TRANSCRIPT_ANALYSIS_JOB_TYPES=silence_analysis,transcript_analysis
SILENCE_ANALYSIS_TIMEOUT_SECONDS=600
TRANSCRIPT_ANALYSIS_TIMEOUT_SECONDS=120
SILENCE_ANALYSIS_MAX_STDERR_BYTES=1048576
TRANSCRIPT_ANALYSIS_TEMP_ROOT=data/transcript-analysis-worker
TRANSCRIPT_ANALYSIS_STORAGE_BACKEND=supabase

# Stage 2.8 authenticated clipping orchestration (all opt-in)
ENABLE_CLIPPING_PROJECT_API=false
ENABLE_RECOMMENDATION_DECISIONS=false
ENABLE_ACCEPTED_RECOMMENDATION_DRAFTS=false
ENABLE_PROJECT_DERIVATION_REQUESTS=false
ENABLE_PROJECT_CONVERSION_REQUESTS=false
CLIPPING_PROJECT_MAX_RANGES=500
CLIPPING_RECOMMENDATION_DECISION_BATCH_MAX=100
CLIPPING_DRAFT_RECOMMENDATION_MAX=500
CLIPPING_PROJECT_PAGE_SIZE_MAX=100

# Stage 3.1 native Rust clipping runtime (worker-only, opt-in)
ENABLE_CLIPPING_RUST_RUNTIME=false
CLIPPING_RUNTIME_BINARY=capinsta-clipping-runtime
CLIPPING_RUNTIME_PROTOCOL_VERSION=1
CLIPPING_RUNTIME_TIMEOUT_SECONDS=120
CLIPPING_RUNTIME_MAX_STDIN_BYTES=67108864
CLIPPING_RUNTIME_MAX_STDOUT_BYTES=134217728
CLIPPING_RUNTIME_MAX_STDERR_BYTES=65536
CLIPPING_RUNTIME_TERMINATE_GRACE_SECONDS=3
ENABLE_PROJECT_DERIVATION_HANDLER=false
ENABLE_PROJECT_CONVERSION_HANDLER=false
PROJECT_DERIVATION_TIMEOUT_SECONDS=120
PROJECT_CONVERSION_TIMEOUT_SECONDS=120

# Stage 3.2 authenticated editable-project handoff (opt-in)
ENABLE_CAPINSTA_PROJECT_HANDOFF=false
ENABLE_SERVER_BACKED_EDITOR_MEDIA=false
CLIPPING_HANDOFF_TTL_SECONDS=900
CLIPPING_HANDOFF_MAX_TTL_SECONDS=3600
CLIPPING_HANDOFF_MAX_MANIFEST_BYTES=67108864
# Stage 3.3 revision-bound clipping preview/export (disabled by default)
ENABLE_CLIPPING_PREVIEW_API=false
ENABLE_CLIPPING_EXPORT_API=false
ENABLE_CLIPPING_EXPORT_HANDLER=false
CLIPPING_EXPORT_PRESET=vertical-mp4-v1
CLIPPING_EXPORT_TIMEOUT_SECONDS=7200
CLIPPING_EXPORT_MAX_OUTPUT_BYTES=2147483648
# CLIPPING_EXPORT_TEMP_ROOT=
# CLIPPING_EXPORT_STORAGE_BACKEND=supabase
# CLIPPING_EXPORT_LOCAL_STORAGE_ROOT=

# Stage 4 private automatic clipper MVP (all disabled by default)
ENABLE_VIRAL_CANDIDATE_ANALYSIS=false
ENABLE_SMART_REFRAME=false
ENABLE_CLIPPER_UI=false
VIRAL_CANDIDATE_PROVIDER_TIMEOUT_SECONDS=90
VIRAL_CANDIDATE_JOB_TIMEOUT_SECONDS=180
VIRAL_CANDIDATE_MAX_INPUT_CHARS=28000
VIRAL_CANDIDATE_MAX_OUTPUT_BYTES=256000
SMART_REFRAME_JOB_TIMEOUT_SECONDS=600
SMART_REFRAME_SAMPLE_FPS=2
SMART_REFRAME_MAX_SAMPLE_FRAMES=180
AUTOMATIC_CLIPPER_STORAGE_BACKEND=supabase
# AUTOMATIC_CLIPPER_TEMP_ROOT=

# Stage 5 private beta (server-only; all disabled by default)
ENABLE_WHOP_ACCESS=false
ENABLE_USAGE_QUOTAS=false
ENABLE_RETENTION_CLEANUP=false
ENABLE_ACCOUNT_DELETION=false
ACCOUNT_DELETION_RECENT_AUTH_SECONDS=900
PRIVATE_BETA_MAX_USERS=0
PRIVATE_BETA_ALLOWLIST=
MAX_SOURCE_DURATION_SECONDS=5400
MAX_ACTIVE_PROCESSING_JOBS_PER_USER=2
MAX_PROCESSING_MINUTES_PER_PERIOD=180
MAX_STORED_SOURCE_BYTES=10737418240
MAX_STORED_EXPORT_BYTES=10737418240
# Legacy aliases retained for existing deployments.
PRIVATE_BETA_MAX_SOURCE_FILE_BYTES=2147483648
PRIVATE_BETA_MAX_SOURCE_DURATION_SECONDS=5400
PRIVATE_BETA_MAX_ACTIVE_PROCESSING_JOBS=2
PRIVATE_BETA_PROCESSING_MINUTES=180
PRIVATE_BETA_MAX_STORED_SOURCE_BYTES=10737418240
PRIVATE_BETA_MAX_CONCURRENT_EXPORTS=1
PRIVATE_BETA_MAX_STORED_EXPORT_BYTES=10737418240
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PRODUCT_ID=
PRIVATE_BETA_ADMIN_USER_IDS=
DISABLE_NEW_UPLOADS=true
DISABLE_CANDIDATE_ANALYSIS=true
DISABLE_CLIPPING_EXPORTS=true
SOURCE_MEDIA_RETENTION_DAYS=7
EXPORT_RETENTION_DAYS=7
TEMP_WORKSPACE_RETENTION_HOURS=24
WHOP_WEBHOOK_RETENTION_DAYS=30
RATE_LIMIT_RETENTION_HOURS=24
