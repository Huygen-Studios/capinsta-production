{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capinsta.local/contracts/capinsta-project-handoff-manifest-v1.schema.json",
  "title": "CapinstaProjectHandoffManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "handoffId",
    "clipProjectId",
    "clipProjectRevision",
    "conversionResultIdentity",
    "targetProjectId",
    "projectSchemaVersion",
    "project",
    "mediaAttachments",
    "provenance",
    "expiresAt",
    "warnings",
    "metadata"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "handoffId": { "type": "string", "format": "uuid" },
    "clipProjectId": { "type": "string", "minLength": 1 },
    "clipProjectRevision": { "type": "integer", "minimum": 1 },
    "conversionResultIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "targetProjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "projectSchemaVersion": { "const": 35 },
    "project": {
      "type": "object",
      "required": ["metadata", "scenes", "settings", "version"],
      "properties": {
        "version": { "const": 35 },
        "metadata": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 }
          }
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1
        },
        "settings": {
          "type": "object",
          "required": ["canvasSize"],
          "properties": {
            "canvasSize": {
              "type": "object",
              "required": ["width", "height"],
              "properties": {
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "mediaAttachments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "mediaId",
          "mediaAssetId",
          "sourceType",
          "mediaKind",
          "mimeType",
          "displayName",
          "sizeBytes",
          "durationMs",
          "width",
          "height",
          "storageProvider",
          "accessMode",
          "requiresBrowserPersistence"
        ],
        "properties": {
          "schemaVersion": { "const": 1 },
          "mediaId": { "type": "string", "minLength": 1 },
          "mediaAssetId": { "type": "string", "format": "uuid" },
          "sourceType": { "const": "server-backed" },
          "mediaKind": {
            "enum": ["video", "audio", "image", "unknown"]
          },
          "mimeType": { "type": ["string", "null"] },
          "displayName": { "type": "string", "minLength": 1 },
          "sizeBytes": { "type": ["integer", "null"], "minimum": 0 },
          "durationMs": { "type": "integer", "minimum": 0 },
          "width": { "type": ["integer", "null"], "minimum": 1 },
          "height": { "type": ["integer", "null"], "minimum": 1 },
          "storageProvider": { "const": "supabase" },
          "accessMode": { "const": "authenticated-server-backed" },
          "requiresBrowserPersistence": { "const": false }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceClipProjectId",
        "sourceClipProjectRevision",
        "conversionSchemaVersion",
        "convertedAt"
      ],
      "properties": {
        "sourceClipProjectId": { "type": "string" },
        "sourceClipProjectRevision": { "type": "integer", "minimum": 1 },
        "conversionSchemaVersion": { "const": 1 },
        "convertedAt": { "type": "null" }
      }
    },
    "expiresAt": { "type": "string", "format": "date-time" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "metadata": { "type": "object" }
  }
}
