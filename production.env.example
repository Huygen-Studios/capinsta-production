CAPINSTA_IMAGE_TAG=production-candidate
APPLICATION_URL=https://staging.example.com
CORS_ORIGINS=https://staging.example.com
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
CLIPPING_STORAGE_PROVIDER=r2
R2_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_REGION=auto
R2_SOURCE_BUCKET=capinsta-source-media
R2_VARIANTS_BUCKET=capinsta-media-variants
R2_EXPORTS_BUCKET=capinsta-media-exports
R2_MULTIPART_PART_SIZE_BYTES=33554432
R2_SIGNED_URL_TTL_SECONDS=900
R2_UPLOAD_CONCURRENCY=3
UPSTASH_REDIS_REST_URL=https://replace-me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
ADMIN_SECURITY_PEPPER=replace-with-at-least-32-random-characters
INTERNAL_ADMIN_API_SECRET=replace-with-at-least-32-random-characters
INTERNAL_MAINTENANCE_SECRET=replace-with-at-least-32-random-characters
CAPINSTA_RENDER_TOKEN_SECRET=replace-with-at-least-32-random-characters
MARBLE_WORKSPACE_KEY=replace-me
PRIVATE_BETA_ALLOWLIST=
PRIVATE_BETA_MAX_USERS=10
LEGACY_CAPTION_STORAGE_ROOT=/app/storage/legacy-caption
TEMP_DIR=/app/storage/legacy-caption/tmp
UPLOAD_DIR=/app/storage/legacy-caption/uploads
MEDIA_DIR=/app/storage/legacy-caption/media
EXPORT_DIR=/app/storage/legacy-caption/exports
CACHE_DIR=/app/storage/legacy-caption/cache
DB_PATH=/app/storage/legacy-caption/database.sqlite
MAX_UPLOAD_SIZE_MB=500
DISK_WARNING_FREE_BYTES=1073741824
DISK_REJECT_UPLOAD_FREE_BYTES=268435456
DISK_CRITICAL_FREE_BYTES=134217728
MAX_SOURCE_FILE_BYTES=2147483648
DISABLE_NEW_UPLOADS=true
DISABLE_CANDIDATE_ANALYSIS=true
DISABLE_CLIPPING_EXPORTS=true
GEMINI_API_KEY=
SARVAM_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
